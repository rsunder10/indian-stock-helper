# Copy to .env and edit. Only the provider you use needs configuring.
# The default (Ollama) and the rule-based fallback need NO API key.

# Which LLM produces the analyst narrative: ollama | anthropic | openai | gemini | rulebased
DEFAULT_LLM_PROVIDER=ollama

# --- Local Ollama (default; run `ollama serve` and e.g. `ollama pull llama3.1`) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI-compatible (OpenAI / Groq / OpenRouter / Together ...) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1   # omit for official OpenAI
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# --- Analysis tunables (optional) ---
# ATR_STOP_MULTIPLE=1.8
# TARGET1_RR=2.0
# TARGET2_RR=3.5
# HISTORY_PERIOD=1y
# NEWS_MAX_ITEMS=8
# NEWS_RECENCY_HALFLIFE_DAYS=7      # sentiment weight halves every N days (0 = flat mean)

# --- Fair-value (intrinsic value) tunables (optional) ---
# FAIR_VALUE_DISCOUNT_RATE=0.12     # cost of equity `r` for the Gordon dividend model
# FAIR_VALUE_TERMINAL_GROWTH=0.05   # cap on dividend growth `g` (must stay < r)
# FAIR_PE_BASE=15.0                 # fair P/E used when growth is unknown
# FAIR_PE_FLOOR=10.0                # lowest justified P/E
# FAIR_PE_CAP=35.0                  # highest justified P/E
# MARGIN_OF_SAFETY=0.15             # +/- band that flips under/fairly/over-valued

# --- Corporate actions: free dividend/split history (optional) ---
# CORPORATE_ACTION_LOOKBACK_YEARS=6  # window for counting dividend-paying years
# DIVIDEND_MIN_CONSISTENT_YEARS=3    # min paying years in the window to trust the dividend-discount model
# SPLIT_RECENCY_DAYS=365             # a split this recent flags a snapshot warning

# --- Macro overlays: bundled government-open-data packs (optional) ---
# Small, bounded, explainable nudges to the score from sector-keyed packs (budget, RBI rate cycle).
# Packs are fetched at build time (scripts/refresh_*.py) and bundled; the analysis path is fully
# offline. See docs/methodology.md ("Macro overlays"). MACRO_MAX_POINTS caps the COMBINED nudge.
# MACRO_MAX_POINTS=6.0               # cap on the combined (signed) nudge across all overlays
# Budget overlay:
# BUDGET_ENABLED=true                # master switch for the budget overlay
# BUDGET_YEAR=2023-24                # selects data/budget_<year>.json (2023-24 ships with REAL data.gov.in figures)
# BUDGET_MAX_POINTS=5.0              # per-source cap on the budget nudge
# BUDGET_YOY_SCALE=20.0              # allocation YoY% that maps to a full (+/-1) tailwind
# BUDGET_API_KEY=                    # free data.gov.in OGD key — used ONLY by the refresh scripts
# RBI rate-cycle overlay:
# RATE_ENABLED=true                  # master switch for the rate-cycle overlay
# RATE_PACK_VERSION=2026             # selects the bundled data/rates_<version>.json pack
# RATE_MAX_POINTS=4.0                # per-source cap on the rate-cycle nudge
# National-indicator overlays (generic engine; SEED packs — refresh headline numbers via
# scripts/refresh_macro.py before trusting magnitudes). Each: <KIND>_ENABLED / _PACK_VERSION /
# _MAX_POINTS / _SCALE (the value-neutral gap that maps to a full +/-1 signal).
# IIP_ENABLED=true                   # Index of Industrial Production (cyclical activity)
# IIP_MAX_POINTS=2.5   IIP_SCALE=4.0
# GST_ENABLED=true                   # GST collections (consumption)
# GST_MAX_POINTS=2.5   GST_SCALE=8.0
# CREDIT_ENABLED=true                # bank credit growth (financing availability)
# CREDIT_MAX_POINTS=2.0   CREDIT_SCALE=6.0
# TRADE_ENABLED=true                 # merchandise exports (external demand)
# TRADE_MAX_POINTS=2.0   TRADE_SCALE=12.0
# INPUTCOST_ENABLED=true             # WPI input-cost inflation (headwind for consumers, tailwind for producers)
# INPUTCOST_MAX_POINTS=2.0   INPUTCOST_SCALE=6.0
# MONSOON_ENABLED=true               # IMD rainfall vs LPA (rural demand)
# MONSOON_MAX_POINTS=1.5   MONSOON_SCALE=10.0

# --- Free-source hardening: yfinance rate/retry discipline (optional) ---
# YF_MAX_RETRIES=3                  # attempts per yfinance call before giving up
# YF_RETRY_BACKOFF=0.5              # base seconds for exponential backoff between retries
# YF_MIN_REQUEST_INTERVAL=0.15      # min seconds between yfinance calls (0 = no throttle)

# --- Backtesting: walk-forward replay of the technical signal (optional) ---
# BACKTEST_HISTORY_PERIOD=5y        # yfinance period fetched per symbol for the replay
# BACKTEST_WARMUP_BARS=200          # bars required before the first signal (SMA-200 needs them)
# BACKTEST_MAX_HOLD_BARS=40         # force a trade to close at the bar's close after this many bars
# BACKTEST_ENTRY_ACTIONS=BUY,ACCUMULATE   # quant actions that open a simulated long
