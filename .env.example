# Copy to .env and edit. Only the provider you use needs configuring.
# The default (Ollama) and the rule-based fallback need NO API key.

# Which LLM produces the analyst narrative: ollama | anthropic | openai | gemini | rulebased
DEFAULT_LLM_PROVIDER=ollama

# --- Local Ollama (default; run `ollama serve` and e.g. `ollama pull llama3.1`) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI-compatible (OpenAI / Groq / OpenRouter / Together ...) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1   # omit for official OpenAI
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# --- Analysis tunables (optional) ---
# ATR_STOP_MULTIPLE=1.8
# TARGET1_RR=2.0
# TARGET2_RR=3.5
# HISTORY_PERIOD=1y

# --- Fair-value (intrinsic value) tunables (optional) ---
# FAIR_VALUE_DISCOUNT_RATE=0.12     # cost of equity `r` for the Gordon dividend model
# FAIR_VALUE_TERMINAL_GROWTH=0.05   # cap on dividend growth `g` (must stay < r)
# FAIR_PE_BASE=15.0                 # fair P/E used when growth is unknown
# FAIR_PE_FLOOR=10.0                # lowest justified P/E
# FAIR_PE_CAP=35.0                  # highest justified P/E
# MARGIN_OF_SAFETY=0.15             # +/- band that flips under/fairly/over-valued

# --- Free-source hardening: yfinance rate/retry discipline (optional) ---
# YF_MAX_RETRIES=3                  # attempts per yfinance call before giving up
# YF_RETRY_BACKOFF=0.5              # base seconds for exponential backoff between retries
# YF_MIN_REQUEST_INTERVAL=0.15      # min seconds between yfinance calls (0 = no throttle)
